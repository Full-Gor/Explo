{
  "expo": {
    "name": "Explo File Explorer",
    "slug": "explo-file-explorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.explo.fileexplorer",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice search",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition for voice commands",
        "NSCameraUsageDescription": "This app uses the camera to scan documents",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to display and manage them",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save photos to your library",
        "NSDocumentsFolderUsageDescription": "This app needs access to your documents folder"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a1f"
      },
      "package": "com.explo.fileexplorer",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-speech-recognition",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4ade80"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
